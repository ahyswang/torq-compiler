    "version": "0.2.0",
    "configurations": [
        {
            "name": "cpp",
            "type": "lldb-dap",
            "request": "launch",
            //"program": "${workspaceFolder}/../iree-build/third_party/iree/tool/torq-compile",
            "program": "/workspace/yswang26/mlir/iree-build/third_party/iree/tools/torq-compile",
            "args": [
                "demo.mlir",
                "-o",
                "./data.ignore/output.vmfb",
                "--mlir-print-ir-after-all",
                //"--torq-enable-tile-and-fuse",
                //"--torq-disable-slices",
                "--debug-only=torq-assign-addresses",
                "--dump-compilation-phases-to=data.ignore"
            ],
            "env": [
                "PATH=/workspace/yswang26/opt/llvm/bin:${env:PATH}"
            ],
            "cwd": "${workspaceFolder}/",
        },
        {
            "name": "python attach",
            "type": "python",
            "request": "attach",
            "justMyCode": false,
            "connect": {
                "host": "localhost",
                "port": 5678
            }
        },
        {
            "name": "python",
            "type": "debugpy",
            "request": "launch",
            "python": "/workspace/yswang26/opt/miniforge3/bin/python",
            "program": "/workspace/yswang26/opt/miniforge3/bin/iree-import-onnx",
            "console": "integratedTerminal",
            "args": "../../../llm/onnx-community-Qwen3-0.6B/model_q4f16.onnx -o model_q4f16.onnx.mlir --large-model --externalize-params",
            "cwd": "${workspaceFolder}/demo/qwen3_0.6b_q4f16"
        }
    ]
}