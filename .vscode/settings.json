{
    // 禁用 cpptools 的 IntelliSense，避免与 clangd 冲突
    "C_Cpp.intelliSenseEngine": "disabled",

    // clangd 路径（可省略如果在 PATH 中）
    "clangd.path": "/usr/bin/clangd",

    // 常用 clangd 参数
    "clangd.arguments": [
        "--background-index",        // 后台全量索引
        "--clang-tidy",              // 启用 clang-tidy 诊断
        "--completion-style=detailed",
        "--header-insertion=iwyu",   // 智能补全自动插入需要的头
        "--cross-file-rename=true"   // 支持跨文件重命名
    ],
    "files.associations": {
        "*.py": "python",
        "functional": "cpp",
        "chrono": "cpp",
        "*.inc": "cpp",
        "ios": "cpp",
        "variant": "cpp",
        "ranges": "cpp",
        "compare": "cpp",
        "cstdint": "cpp",
        "format": "cpp",
        "array": "cpp",
        "bitset": "cpp",
        "string_view": "cpp",
        "hash_map": "cpp",
        "initializer_list": "cpp",
        "span": "cpp",
        "regex": "cpp",
        "utility": "cpp",
        "valarray": "cpp",
        "sim_initializer_list": "cpp",
        "sim_vector": "cpp",
        "__hash_table": "cpp",
        "__split_buffer": "cpp",
        "__tree": "cpp",
        "deque": "cpp",
        "list": "cpp",
        "map": "cpp",
        "queue": "cpp",
        "set": "cpp",
        "stack": "cpp",
        "string": "cpp",
        "unordered_map": "cpp",
        "unordered_set": "cpp",
        "vector": "cpp",
        "algorithm": "cpp",
        "__locale": "cpp",
        "random": "cpp",
        "forward_list": "cpp",
        "__bit_reference": "cpp",
        "atomic": "cpp",
        "bit": "cpp",
        "cctype": "cpp",
        "cmath": "cpp",
        "concepts": "cpp",
        "condition_variable": "cpp",
        "cstdarg": "cpp",
        "cstddef": "cpp",
        "cstdio": "cpp",
        "cstdlib": "cpp",
        "cstring": "cpp",
        "ctime": "cpp",
        "cwchar": "cpp",
        "cwctype": "cpp",
        "exception": "cpp",
        "iterator": "cpp",
        "memory": "cpp",
        "memory_resource": "cpp",
        "optional": "cpp",
        "ratio": "cpp",
        "system_error": "cpp",
        "tuple": "cpp",
        "type_traits": "cpp",
        "iosfwd": "cpp",
        "limits": "cpp",
        "mutex": "cpp",
        "new": "cpp",
        "numbers": "cpp",
        "ostream": "cpp",
        "stdexcept": "cpp",
        "streambuf": "cpp",
        "thread": "cpp",
        "typeinfo": "cpp",
        "clocale": "cpp",
        "complex": "cpp",
        "istream": "cpp",
        "numeric": "cpp",
        "semaphore": "cpp",
        "shared_mutex": "cpp",
        "sstream": "cpp",
        "stop_token": "cpp",
        "__verbose_abort": "cpp",
        "locale": "cpp",
        "execution": "cpp",
        "print": "cpp",
        "*.cpp_v2": "cpp",
        "propagate_const": "cpp",
        "future": "cpp",
        "scoped_allocator": "cpp"
    }
}