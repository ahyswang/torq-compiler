  <diagram id="state-transition" name="状态转换图">
    <mxGraphModel dx="1422" dy="762" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="st_title" value="VirtualBuffer 状态转换图" style="text;html=1;fontSize=20;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="350" y="20" width="400" height="40" as="geometry" />
        </mxCell>

        <!-- Swapped In State -->
        <mxCell id="sin" value="&lt;b&gt;已换入 (Swapped In)&lt;/b&gt;&lt;br&gt;&lt;br&gt;maybePhysicalBuffer_ 有值&lt;br&gt;swappedOutValue_ = null&lt;br&gt;&lt;br&gt;数据在目标内存空间(如LRAM)&lt;br&gt;持有 PhysicalBuffer（有地址）&lt;br&gt;可以被直接访问" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="100" y="150" width="280" height="160" as="geometry" />
        </mxCell>

        <!-- Swapped Out State -->
        <mxCell id="sout" value="&lt;b&gt;已换出 (Swapped Out)&lt;/b&gt;&lt;br&gt;&lt;br&gt;maybePhysicalBuffer_ = nullopt&lt;br&gt;swappedOutValue_ 有值&lt;br&gt;&lt;br&gt;数据在交换空间(如XRAM)&lt;br&gt;无物理缓冲区&lt;br&gt;访问前需先换入" style="rounded=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="650" y="150" width="280" height="160" as="geometry" />
        </mxCell>

        <!-- Pinned State (overlay) -->
        <mxCell id="pinned" value="&lt;b&gt;已固定 (Pinned)&lt;/b&gt;&lt;br&gt;pinCount_ &amp;gt; 0&lt;br&gt;不可被换出" style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="350" width="280" height="60" as="geometry" />
        </mxCell>

        <!-- Swap Out Arrow -->
        <mxCell id="so_arrow" style="endArrow=block;endFill=1;strokeWidth=2;strokeColor=#b85450;" edge="1" source="sin" target="sout" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="520" y="190" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="so_label" value="swapOut()&lt;br&gt;1. AllocOp (XRAM)&lt;br&gt;2. StoreOp (LRAM→XRAM)&lt;br&gt;3. DeallocOp (LRAM)&lt;br&gt;4. Pool::free()" style="text;fontSize=10;align=center;fillColor=#FFF;rounded=1;strokeColor=#ccc;" vertex="1" parent="1">
          <mxGeometry x="420" y="100" width="190" height="80" as="geometry" />
        </mxCell>

        <!-- Swap In Arrow -->
        <mxCell id="si_arrow" style="endArrow=block;endFill=1;strokeWidth=2;strokeColor=#82b366;" edge="1" source="sout" target="sin" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="520" y="280" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="si_label" value="swapIn()&lt;br&gt;1. AllocOp (LRAM)&lt;br&gt;2. LoadOp (XRAM→LRAM)&lt;br&gt;3. DeallocOp (XRAM)&lt;br&gt;4. Pool::allocate()" style="text;fontSize=10;align=center;fillColor=#FFF;rounded=1;strokeColor=#ccc;" vertex="1" parent="1">
          <mxGeometry x="420" y="280" width="190" height="80" as="geometry" />
        </mxCell>

        <!-- Pin/Unpin arrows -->
        <mxCell id="pin_arrow" style="endArrow=block;endFill=1;strokeWidth=1;curved=1;" edge="1" source="sin" target="pinned" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pin_label" value="pin()" style="text;fontSize=10;" vertex="1" connectable="0" parent="pin_arrow">
          <mxGeometry x="-0.3" relative="1" as="geometry">
            <mxPoint x="-30" as="offset" />
          </mxGeometry>
        </mxCell>

        <mxCell id="unpin_arrow" style="endArrow=block;endFill=1;strokeWidth=1;curved=1;" edge="1" source="pinned" target="sin" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="unpin_label" value="unpin()" style="text;fontSize=10;" vertex="1" connectable="0" parent="unpin_arrow">
          <mxGeometry x="0.3" relative="1" as="geometry">
            <mxPoint x="20" as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- Initialize -->
        <mxCell id="init_dot" value="" style="ellipse;fillColor=#000;" vertex="1" parent="1">
          <mxGeometry x="220" y="80" width="20" height="20" as="geometry" />
        </mxCell>
        <mxCell id="init_arrow" style="endArrow=block;endFill=1;strokeWidth=2;" edge="1" source="init_dot" target="sin" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="init_label" value="initialize()" style="text;fontSize=10;" vertex="1" connectable="0" parent="init_arrow">
          <mxGeometry x="0.5" relative="1" as="geometry">
            <mxPoint x="25" as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- Deallocate -->
        <mxCell id="dealloc_dot" value="" style="ellipse;fillColor=#000;strokeColor=#000;" vertex="1" parent="1">
          <mxGeometry x="520" y="440" width="24" height="24" as="geometry" />
        </mxCell>
        <mxCell id="dealloc_dot_inner" value="" style="ellipse;fillColor=#FFF;strokeColor=#000;" vertex="1" parent="1">
          <mxGeometry x="524" y="444" width="16" height="16" as="geometry" />
        </mxCell>
        <mxCell id="d1" style="endArrow=block;endFill=1;strokeWidth=1;dashed=1;" edge="1" source="sin" target="dealloc_dot" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d1l" value="deallocate()" style="text;fontSize=10;" vertex="1" connectable="0" parent="d1">
          <mxGeometry x="0.5" relative="1" as="geometry">
            <mxPoint x="-50" y="5" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="d2" style="endArrow=block;endFill=1;strokeWidth=1;dashed=1;" edge="1" source="sout" target="dealloc_dot" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d2l" value="deallocate()" style="text;fontSize=10;" vertex="1" connectable="0" parent="d2">
          <mxGeometry x="0.5" relative="1" as="geometry">
            <mxPoint x="30" y="5" as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- Notes -->
        <mxCell id="note1" value="注意：&lt;br&gt;• 已固定状态的缓冲区不可被换出&lt;br&gt;• 碎片整理时只换出未固定的缓冲区&lt;br&gt;• 别名 (VirtualAlias) 的换入需先换入父对象" style="shape=note;size=15;fillColor=#ffffcc;strokeColor=#ccc;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="700" y="400" width="300" height="80" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="main-flow" name="核心处理流程">
    <mxGraphModel dx="1422" dy="762" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="ft" value="convertVirtualToPhysicalMemRefs 核心流程" style="text;html=1;fontSize=18;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="300" y="10" width="500" height="40" as="geometry" />
        </mxCell>

        <!-- Start -->
        <mxCell id="start" value="开始" style="ellipse;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="490" y="60" width="80" height="40" as="geometry" />
        </mxCell>

        <!-- Init -->
        <mxCell id="init" value="初始化 VirtualMemory(pool, memSpace)&lt;br&gt;收集函数体中所有 Operation" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="380" y="120" width="300" height="50" as="geometry" />
        </mxCell>
        <mxCell id="ea1" style="endArrow=block;endFill=1;" edge="1" source="start" target="init" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Loop -->
        <mxCell id="loop" value="遍历每个 Operation" style="shape=hexagon;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="400" y="200" width="260" height="40" as="geometry" />
        </mxCell>
        <mxCell id="ea2" style="endArrow=block;endFill=1;" edge="1" source="init" target="loop" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Decision: DeallocOp? -->
        <mxCell id="d_dealloc" value="是 DeallocOp？" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="430" y="270" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ea3" style="endArrow=block;endFill=1;" edge="1" source="loop" target="d_dealloc" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Dealloc action -->
        <mxCell id="a_dealloc" value="1. vm.deallocate(memref)&lt;br&gt;2. 更新 dealloc 操作指向物理值" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="700" y="275" width="250" height="50" as="geometry" />
        </mxCell>
        <mxCell id="ea4" value="是" style="endArrow=block;endFill=1;fontSize=10;" edge="1" source="d_dealloc" target="a_dealloc" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Decision: Alias Op? -->
        <mxCell id="d_alias" value="是别名操作？&lt;br&gt;(subview等)" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="430" y="360" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ea5" value="否" style="endArrow=block;endFill=1;fontSize=10;" edge="1" source="d_dealloc" target="d_alias" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Alias action -->
        <mxCell id="a_alias" value="vm.addAlias(result)&lt;br&gt;不执行换入（延迟到实际使用）" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="700" y="365" width="250" height="50" as="geometry" />
        </mxCell>
        <mxCell id="ea6" value="是" style="endArrow=block;endFill=1;fontSize=10;" edge="1" source="d_alias" target="a_alias" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Regular op steps -->
        <mxCell id="s1" value="收集 memref 操作数和结果&lt;br&gt;筛选属于目标内存空间的值" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="380" y="460" width="300" height="45" as="geometry" />
        </mxCell>
        <mxCell id="ea7" value="否" style="endArrow=block;endFill=1;fontSize=10;" edge="1" source="d_alias" target="s1" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="s2" value="区分操作数状态：&lt;br&gt;• 已换入 → 立即 pin()（防止被换出）&lt;br&gt;• 已换出 → 加入 toSwapIn 集合" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="380" y="525" width="300" height="55" as="geometry" />
        </mxCell>
        <mxCell id="ea8" style="endArrow=block;endFill=1;" edge="1" source="s1" target="s2" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="s3" value="vm.freeSpace(swapInSize + resultsSize)&lt;br&gt;释放空间（LRU 换出未固定缓冲区）" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="380" y="605" width="300" height="45" as="geometry" />
        </mxCell>
        <mxCell id="ea9" style="endArrow=block;endFill=1;" edge="1" source="s2" target="s3" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="s4" value="unpin() 所有已固定的操作数" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="380" y="675" width="300" height="35" as="geometry" />
        </mxCell>
        <mxCell id="ea10" style="endArrow=block;endFill=1;" edge="1" source="s3" target="s4" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="s5" value="vm.swapIn() 所有待换入的操作数&lt;br&gt;（如需碎片整理则自动执行）" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="380" y="735" width="300" height="45" as="geometry" />
        </mxCell>
        <mxCell id="ea11" style="endArrow=block;endFill=1;" edge="1" source="s4" target="s5" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="s6" value="vm.addAllocation() 为每个 memref 结果分配物理缓冲区" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="380" y="805" width="300" height="35" as="geometry" />
        </mxCell>
        <mxCell id="ea12" style="endArrow=block;endFill=1;" edge="1" source="s5" target="s6" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="s7" value="pin() 所有 memref 操作数&lt;br&gt;替换虚拟值为物理值 (opOperand.set)" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="380" y="865" width="300" height="45" as="geometry" />
        </mxCell>
        <mxCell id="ea13" style="endArrow=block;endFill=1;" edge="1" source="s6" target="s7" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Decision: StartProgramOp? -->
        <mxCell id="d_start" value="是 StartProgramOp？" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="410" y="940" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="ea14" style="endArrow=block;endFill=1;" edge="1" source="s7" target="d_start" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="a_start" value="保存固定值到&lt;br&gt;invocationToVirtual 映射&lt;br&gt;（保持 pin 状态）" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="700" y="935" width="200" height="55" as="geometry" />
        </mxCell>
        <mxCell id="ea15" value="是" style="endArrow=block;endFill=1;fontSize=10;" edge="1" source="d_start" target="a_start" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="s8" value="unpin() 所有操作数" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="380" y="1020" width="300" height="35" as="geometry" />
        </mxCell>
        <mxCell id="ea16" value="否" style="endArrow=block;endFill=1;fontSize=10;" edge="1" source="d_start" target="s8" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Decision: WaitProgramOp? -->
        <mxCell id="d_wait" value="是 WaitProgramOp？" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="410" y="1085" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="ea17" style="endArrow=block;endFill=1;" edge="1" source="s8" target="d_wait" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="a_wait" value="unpin() 对应 Start 操作&lt;br&gt;固定的所有虚拟值" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="700" y="1087" width="200" height="45" as="geometry" />
        </mxCell>
        <mxCell id="ea18" value="是" style="endArrow=block;endFill=1;fontSize=10;" edge="1" source="d_wait" target="a_wait" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Back to loop -->
        <mxCell id="next" value="处理下一个 Operation" style="rounded=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="430" y="1165" width="200" height="35" as="geometry" />
        </mxCell>
        <mxCell id="ea19" style="endArrow=block;endFill=1;" edge="1" source="d_wait" target="next" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ea19b" style="endArrow=block;endFill=1;dashed=1;" edge="1" source="a_dealloc" target="next" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="970" y="1180" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="ea19c" style="endArrow=block;endFill=1;dashed=1;" edge="1" source="a_alias" target="next" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="960" y="1180" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="ea19d" style="endArrow=block;endFill=1;dashed=1;" edge="1" source="a_start" target="next" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="950" y="1180" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="ea19e" style="endArrow=block;endFill=1;dashed=1;" edge="1" source="a_wait" target="next" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="940" y="1180" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Loop back arrow -->
        <mxCell id="ea20" style="endArrow=block;endFill=1;curved=1;" edge="1" source="next" target="loop" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="200" y="1180" />
              <mxPoint x="200" y="220" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- End -->
        <mxCell id="stats" value="输出统计信息&lt;br&gt;(碎片整理次数、换出次数)" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="410" y="1230" width="240" height="40" as="geometry" />
        </mxCell>
        <mxCell id="ea21" value="全部处理完成" style="endArrow=block;endFill=1;fontSize=10;" edge="1" source="next" target="stats" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="endnode" value="结束" style="ellipse;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="490" y="1300" width="80" height="40" as="geometry" />
        </mxCell>
        <mxCell id="ea22" style="endArrow=block;endFill=1;" edge="1" source="stats" target="endnode" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>

      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="memory-layout" name="内存布局示意">
    <mxGraphModel dx="1200" dy="762" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="mt" value="虚拟内存 — 物理内存映射与换入换出示意" style="text;html=1;fontSize=18;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="200" y="10" width="600" height="40" as="geometry" />
        </mxCell>

        <!-- Virtual Space -->
        <mxCell id="vs_bg" value="" style="rounded=1;fillColor=#f5f5f5;strokeColor=#999;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="60" width="320" height="580" as="geometry" />
        </mxCell>
        <mxCell id="vs_title" value="虚拟空间（无限）" style="text;fontSize=14;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="80" y="65" width="220" height="30" as="geometry" />
        </mxCell>

        <mxCell id="vb1" value="VirtualBuffer A (256B)" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="110" width="260" height="40" as="geometry" />
        </mxCell>
        <mxCell id="vb2" value="VirtualBuffer B (512B)" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="170" width="260" height="40" as="geometry" />
        </mxCell>
        <mxCell id="vb3" value="VirtualBuffer C (128B)" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="230" width="260" height="40" as="geometry" />
        </mxCell>
        <mxCell id="va1" value="VirtualAlias C&#39; (subview of C)" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="280" width="220" height="35" as="geometry" />
        </mxCell>
        <mxCell id="alias_edge" style="endArrow=open;endFill=0;dashed=1;strokeColor=#82b366;" edge="1" source="va1" target="vb3" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="vb4" value="VirtualBuffer D (384B)" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="340" width="260" height="40" as="geometry" />
        </mxCell>
        <mxCell id="vb5" value="VirtualBuffer E (256B)" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="400" width="260" height="40" as="geometry" />
        </mxCell>
        <mxCell id="vb_etc" value="..." style="text;fontSize=14;align=center;" vertex="1" parent="1">
          <mxGeometry x="150" y="450" width="80" height="30" as="geometry" />
        </mxCell>

        <!-- Physical Space (LRAM) -->
        <mxCell id="ps_bg" value="" style="rounded=0;fillColor=#fff;strokeColor=#333;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="440" y="60" width="260" height="400" as="geometry" />
        </mxCell>
        <mxCell id="ps_title" value="物理空间 LRAM (1024B)" style="text;fontSize=14;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="440" y="65" width="260" height="30" as="geometry" />
        </mxCell>

        <!-- Pool slots -->
        <mxCell id="ps_reserved" value="Reserved" style="fillColor=#e6e6e6;strokeColor=#999;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="450" y="100" width="240" height="25" as="geometry" />
        </mxCell>
        <mxCell id="ps_a" value="Buffer A (256B) [addr:64]" style="fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="450" y="130" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="ps_c" value="Buffer C (128B) [addr:320]" style="fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="450" y="185" width="240" height="30" as="geometry" />
        </mxCell>
        <mxCell id="ps_free1" value="(空闲)" style="fillColor=#FFFFFF;strokeColor=#ccc;fontSize=10;fontColor=#999;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="450" y="220" width="240" height="40" as="geometry" />
        </mxCell>
        <mxCell id="ps_e" value="Buffer E (256B) [addr:512]" style="fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="450" y="265" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="ps_free2" value="(空闲)" style="fillColor=#FFFFFF;strokeColor=#ccc;fontSize=10;fontColor=#999;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="450" y="320" width="240" height="25" as="geometry" />
        </mxCell>
        <mxCell id="ps_d" value="Buffer D (384B) [addr:640]" style="fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="450" y="350" width="240" height="70" as="geometry" />
        </mxCell>

        <mxCell id="ps_label_small" value="← 小对象从低地址分配" style="text;fontSize=9;fontColor=#666;" vertex="1" parent="1">
          <mxGeometry x="455" y="425" width="200" height="20" as="geometry" />
        </mxCell>
        <mxCell id="ps_label_large" value="← 大对象从高地址分配" style="text;fontSize=9;fontColor=#666;" vertex="1" parent="1">
          <mxGeometry x="455" y="440" width="200" height="20" as="geometry" />
        </mxCell>

        <!-- Swap Space (XRAM) -->
        <mxCell id="ss_bg" value="" style="rounded=0;fillColor=#fff;strokeColor=#b85450;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="790" y="60" width="240" height="250" as="geometry" />
        </mxCell>
        <mxCell id="ss_title" value="交换空间 XRAM" style="text;fontSize=14;fontStyle=1;align=center;fontColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="790" y="65" width="240" height="30" as="geometry" />
        </mxCell>

        <mxCell id="ss_b" value="Swapped Buffer B (512B)" style="fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="800" y="110" width="220" height="60" as="geometry" />
        </mxCell>

        <!-- Arrows: Virtual -> Physical -->
        <mxCell id="m1" style="endArrow=block;endFill=1;strokeColor=#82b366;strokeWidth=1;" edge="1" source="vb1" target="ps_a" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m3" style="endArrow=block;endFill=1;strokeColor=#82b366;strokeWidth=1;" edge="1" source="vb3" target="ps_c" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m4" style="endArrow=block;endFill=1;strokeColor=#82b366;strokeWidth=1;" edge="1" source="vb4" target="ps_d" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m5" style="endArrow=block;endFill=1;strokeColor=#82b366;strokeWidth=1;" edge="1" source="vb5" target="ps_e" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Arrow: Virtual -> Swap -->
        <mxCell id="m2" style="endArrow=block;endFill=1;strokeColor=#b85450;strokeWidth=2;dashed=1;" edge="1" source="vb2" target="ss_b" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m2_label" value="已换出" style="text;fontSize=10;fontColor=#b85450;fontStyle=1;" vertex="1" connectable="0" parent="m2">
          <mxGeometry x="0.5" relative="1" as="geometry">
            <mxPoint y="-12" as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- LRU indicator -->
        <mxCell id="lru_bg" value="" style="rounded=1;fillColor=#f5f5f5;strokeColor=#999;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="790" y="340" width="240" height="150" as="geometry" />
        </mxCell>
        <mxCell id="lru_title" value="LRU 队列（最近→最久）" style="text;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="790" y="345" width="240" height="25" as="geometry" />
        </mxCell>
        <mxCell id="lru1" value="4. Buffer D (最近使用)" style="text;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="800" y="380" width="220" height="20" as="geometry" />
        </mxCell>
        <mxCell id="lru2" value="3. Buffer E" style="text;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="800" y="400" width="220" height="20" as="geometry" />
        </mxCell>
        <mxCell id="lru3" value="2. Buffer C" style="text;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="800" y="420" width="220" height="20" as="geometry" />
        </mxCell>
        <mxCell id="lru4" value="1. Buffer A (最久未使用 ← 优先换出)" style="text;fontSize=10;fontColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="800" y="440" width="220" height="20" as="geometry" />
        </mxCell>

        <!-- Notes -->
        <mxCell id="note_mem" value="说明：&lt;br&gt;• 绿色箭头：虚拟缓冲区映射到物理缓冲区（已换入）&lt;br&gt;• 红色虚线：虚拟缓冲区被换出到交换空间&lt;br&gt;• 空闲区域可由新分配使用&lt;br&gt;• 如空闲区域碎片化，执行碎片整理后重试" style="shape=note;size=15;fillColor=#ffffcc;strokeColor=#ccc;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="440" y="520" width="340" height="100" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
