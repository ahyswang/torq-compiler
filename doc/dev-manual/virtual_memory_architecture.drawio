<mxfile host="app.diagrams.net" modified="2026-03-10T22:00:00.000Z" agent="Torq Compiler Documentation" version="24.0.0" type="device">
  <diagram id="class-hierarchy" name="类层次结构">
    <mxGraphModel dx="1422" dy="762" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title1" value="VirtualMemory 类层次结构" style="text;html=1;fontSize=20;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="500" y="20" width="400" height="40" as="geometry" />
        </mxCell>

        <!-- PhysicalObject -->
        <mxCell id="po" value="&lt;b&gt;PhysicalObject&lt;/b&gt;&lt;hr&gt;- value_: Value&lt;hr&gt;+ touch(): void {abstract}&lt;br&gt;+ vm(): VirtualMemory&amp;amp;&lt;br&gt;+ isPinned(): bool&lt;br&gt;+ virtualObject(): VirtualObject&amp;amp; {abstract}" style="shape=mxgraph.unified_modeling_language.class;verticalAlign=top;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="80" y="100" width="300" height="160" as="geometry" />
        </mxCell>

        <!-- PhysicalBuffer -->
        <mxCell id="pb" value="&lt;b&gt;PhysicalBuffer&lt;/b&gt;&lt;hr&gt;- virtualBuffer_: VirtualBuffer&amp;amp;&lt;br&gt;- address_: int&lt;hr&gt;+ address(): int&lt;br&gt;+ size(): int&lt;br&gt;+ touch(): void" style="shape=mxgraph.unified_modeling_language.class;verticalAlign=top;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="20" y="330" width="250" height="140" as="geometry" />
        </mxCell>

        <!-- PhysicalAlias -->
        <mxCell id="pa" value="&lt;b&gt;PhysicalAlias&lt;/b&gt;&lt;hr&gt;- virtualAlias_: VirtualAlias&amp;amp;&lt;hr&gt;+ parent(): PhysicalObject&amp;amp;&lt;br&gt;+ touch(): void" style="shape=mxgraph.unified_modeling_language.class;verticalAlign=top;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="290" y="330" width="250" height="120" as="geometry" />
        </mxCell>

        <!-- Inheritance arrows for Physical -->
        <mxCell id="e1" edge="1" source="pb" target="po" parent="1">
          <mxGeometry relative="1" as="geometry" />
          <mxCell style="endArrow=block;endFill=0;strokeWidth=2;" />
        </mxCell>
        <mxCell id="e2" edge="1" source="pa" target="po" parent="1">
          <mxGeometry relative="1" as="geometry" />
          <mxCell style="endArrow=block;endFill=0;strokeWidth=2;" />
        </mxCell>

        <!-- VirtualObject -->
        <mxCell id="vo" value="&lt;b&gt;VirtualObject&lt;/b&gt;&lt;hr&gt;- id_: int&lt;br&gt;- vm_: VirtualMemory&amp;amp;&lt;br&gt;- value_: Value&lt;br&gt;- pinCount_: int&lt;br&gt;- aliases_: SmallVector&lt;hr&gt;+ root(): VirtualBuffer&amp;amp; {abstract}&lt;br&gt;+ pin()/unpin(): void&lt;br&gt;+ swapIn(): FailureOr {abstract}&lt;br&gt;+ touch(): void&lt;br&gt;+ addAlias(): VirtualAlias&amp;amp;" style="shape=mxgraph.unified_modeling_language.class;verticalAlign=top;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="640" y="80" width="280" height="210" as="geometry" />
        </mxCell>

        <!-- VirtualBuffer -->
        <mxCell id="vb" value="&lt;b&gt;VirtualBuffer&lt;/b&gt;&lt;hr&gt;- size_: int&lt;br&gt;- maybePhysicalBuffer_: optional&lt;br&gt;- swappedOutValue_: Value&lt;hr&gt;+ initialize(): LogicalResult&lt;br&gt;+ swapIn(): FailureOr&lt;br&gt;+ swapOut(): void&lt;br&gt;+ pin()/unpin(): void" style="shape=mxgraph.unified_modeling_language.class;verticalAlign=top;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="600" y="360" width="260" height="180" as="geometry" />
        </mxCell>

        <!-- VirtualAlias -->
        <mxCell id="va" value="&lt;b&gt;VirtualAlias&lt;/b&gt;&lt;hr&gt;- maybePhysicalAlias: optional&lt;br&gt;- parent_: VirtualObject&amp;amp;&lt;br&gt;- parentOperand_: OpOperand&amp;amp;&lt;hr&gt;+ invalidate(): void&lt;br&gt;+ swapIn(): FailureOr&lt;br&gt;+ pin()/unpin(): void" style="shape=mxgraph.unified_modeling_language.class;verticalAlign=top;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="890" y="360" width="260" height="170" as="geometry" />
        </mxCell>

        <!-- Inheritance arrows for Virtual -->
        <mxCell id="e3" style="endArrow=block;endFill=0;strokeWidth=2;" edge="1" source="vb" target="vo" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" style="endArrow=block;endFill=0;strokeWidth=2;" edge="1" source="va" target="vo" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Association: VirtualBuffer <-> PhysicalBuffer -->
        <mxCell id="e5" style="endArrow=diamond;endFill=1;strokeWidth=1;dashed=1;strokeColor=#FF0000;" edge="1" source="pb" target="vb" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5label" value="1:0..1" style="text;fontSize=10;fontColor=#FF0000;" vertex="1" connectable="0" parent="e5">
          <mxGeometry x="0.5" relative="1" as="geometry">
            <mxPoint y="-10" as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- Association: VirtualAlias <-> PhysicalAlias -->
        <mxCell id="e6" style="endArrow=diamond;endFill=1;strokeWidth=1;dashed=1;strokeColor=#FF0000;" edge="1" source="pa" target="va" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6label" value="1:0..1" style="text;fontSize=10;fontColor=#FF0000;" vertex="1" connectable="0" parent="e6">
          <mxGeometry x="0.5" relative="1" as="geometry">
            <mxPoint y="-10" as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- Manager Classes -->
        <!-- PhysicalMemory -->
        <mxCell id="pm" value="&lt;b&gt;PhysicalMemory&lt;/b&gt;&lt;hr&gt;- physicalBuffers_: DenseMap&lt;br&gt;- lastUsedPhysicalBuffer_: SetVector (LRU)&lt;br&gt;- pinnedBuffers_: DenseMap&lt;br&gt;- pool_: Pool&amp;amp;&lt;hr&gt;+ add()/remove(): manage PhysicalBuffers&lt;br&gt;+ pin()/unpin(): manage pinning&lt;br&gt;+ touch(): update LRU order&lt;br&gt;+ freeSpace(): evict LRU buffers&lt;br&gt;+ defragment(): compact memory" style="shape=mxgraph.unified_modeling_language.class;verticalAlign=top;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="80" y="580" width="320" height="200" as="geometry" />
        </mxCell>

        <!-- VirtualObjects -->
        <mxCell id="vos" value="&lt;b&gt;VirtualObjects&lt;/b&gt;&lt;hr&gt;- virtualBuffers_: DenseMap&lt;br&gt;- virtualObjects_: DenseMap&lt;hr&gt;+ addBuffer(): LogicalResult&lt;br&gt;+ addAlias(): void&lt;br&gt;+ getVirtualObject(): VirtualObject&amp;amp;&lt;br&gt;+ getPhysicalValue(): Value" style="shape=mxgraph.unified_modeling_language.class;verticalAlign=top;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="600" y="600" width="280" height="160" as="geometry" />
        </mxCell>

        <!-- VirtualMemory -->
        <mxCell id="vm" value="&lt;b&gt;VirtualMemory&lt;/b&gt;&lt;hr&gt;+ virtualObjects: VirtualObjects&lt;br&gt;+ physicalMemory: PhysicalMemory&lt;br&gt;+ memorySpace: MemorySpace&lt;br&gt;+ swapMemSpace: MemorySpace&lt;hr&gt;+ deallocate() / addAllocation()&lt;br&gt;+ addAlias() / touch()&lt;br&gt;+ swapIn() / freeSpace()&lt;br&gt;+ pin() / unpin()" style="shape=mxgraph.unified_modeling_language.class;verticalAlign=top;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="300" y="850" width="300" height="180" as="geometry" />
        </mxCell>

        <!-- Pool -->
        <mxCell id="pool" value="&lt;b&gt;Pool&lt;/b&gt;&lt;hr&gt;- wordSizeBytes_: int&lt;br&gt;- used_: SmallVector&amp;lt;bool&amp;gt;&lt;br&gt;- allocations_: DenseMap&lt;hr&gt;+ allocate(): FailureOr&amp;lt;int&amp;gt;&lt;br&gt;+ free(): void&lt;br&gt;+ usedSize() / usableSize()" style="shape=mxgraph.unified_modeling_language.class;verticalAlign=top;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="1100" y="620" width="240" height="150" as="geometry" />
        </mxCell>

        <!-- Composition arrows -->
        <mxCell id="e7" style="endArrow=diamond;endFill=1;strokeWidth=2;" edge="1" source="pm" target="vm" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" style="endArrow=diamond;endFill=1;strokeWidth=2;" edge="1" source="vos" target="vm" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" style="endArrow=open;endFill=0;strokeWidth=1;dashed=1;" edge="1" source="pm" target="pool" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9label" value="uses" style="text;fontSize=10;" vertex="1" connectable="0" parent="e9">
          <mxGeometry x="0.5" relative="1" as="geometry">
            <mxPoint y="-10" as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- Legend -->
        <mxCell id="legend" value="" style="rounded=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1100" y="100" width="220" height="180" as="geometry" />
